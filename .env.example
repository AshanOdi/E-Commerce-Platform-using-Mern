# Copy this file's variable NAMES into Render's dashboard (Environment tab)
# for the deployed service. Never commit real values — .env itself stays
# gitignored; this file only documents what's required.

# MongoDB Atlas connection string (same one used locally)
MONGODB_URL=

# Secret used to sign/verify JWTs — any long random string, kept identical
# across restarts or existing logins are invalidated
JWT_KEY=

# The deployed frontend's exact origin (Vercel production URL), used for CORS.
# Local dev falls back to http://localhost:5173 if this is unset.
FRONTEND_URL=

# HMAC secret the mock payment webhook uses to verify incoming signatures
MOCKPAY_WEBHOOK_SECRET=

# Google Gemini API key + model, used by the AI Beauty & Style Concierge
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Render sets PORT automatically — do not set this manually on Render.
